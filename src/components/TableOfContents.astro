---
import { t } from "@/i18n/ui";

type Heading = { depth: number; slug: string; text: string };
type Props = { headings: Heading[] };

const { headings } = Astro.props;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{
  toc.length > 1 && (
    <div id="toc-root" data-pagefind-ignore>
      {/* Trigger tab — only shown at <xl */}
      <button
        id="toc-btn"
        aria-label={t("toc.title")}
        aria-expanded="false"
        aria-controls="toc-panel"
        title={t("toc.title")}
        data-i18n-attr="aria-label:toc.title,title:toc.title"
      >
        {/* Indented-lines icon suggesting TOC hierarchy */}
        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
          class="size-4"
        >
          <line x1="1" y1="3" x2="15" y2="3" />
          <line x1="4" y1="8" x2="15" y2="8" />
          <line x1="7" y1="13" x2="15" y2="13" />
        </svg>
      </button>

      {/* TOC panel */}
      <nav
        id="toc-panel"
        aria-label={t("toc.title")}
        data-i18n-attr="aria-label:toc.title"
      >
        <p class="toc-label" data-i18n="toc.title">
          {t("toc.title")}
        </p>
        <ul>
          {toc.map(h => (
            <li>
              <a
                href={`#${h.slug}`}
                class:list={["toc-link", { "toc-h3": h.depth === 3 }]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}

<style>
  /* ── Shared ──────────────────────────────────── */
  #toc-root {
    position: fixed;
    z-index: 40;
  }

  .toc-label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.4;
    margin-bottom: 0.5rem;
  }

  .toc-link {
    display: block;
    font-size: 0.8125rem; /* 13px */
    line-height: 1.45;
    padding: 0.2rem 0;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    text-decoration: none;
    transition: color 0.15s;
    word-break: break-word;
  }

  .toc-link.toc-h3 {
    padding-left: 0.75rem;
    font-size: 0.75rem;
  }

  .toc-link:hover {
    color: var(--color-foreground);
  }

  .toc-link.toc-active {
    color: var(--color-accent);
    font-weight: 500;
  }

  /* ── xl+ : float in the right margin of the article ── */
  /* Article is max-w-3xl (48rem) centered, so its right edge
     is at calc(50% + 24rem). We place TOC 1rem to the right. */
  @media (min-width: 1280px) {
    #toc-root {
      left: calc(50% + 25rem);
      top: 6rem;
      width: 12rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
    }

    #toc-btn {
      display: none;
    }

    #toc-panel {
      opacity: 0.55;
      transition: opacity 0.25s ease;
    }

    #toc-root:hover #toc-panel {
      opacity: 1;
    }
  }

  /* ── <xl : trigger tab + slide-in panel from right ── */
  @media (max-width: 1279px) {
    #toc-root {
      right: 0;
      top: 42vh;
      /* Only as wide as the trigger button — panel is absolute */
    }

    #toc-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      padding: 0.875rem 0.3125rem;
      background: var(--color-background);
      border: 1px solid var(--color-border);
      border-right: none;
      border-radius: 0.375rem 0 0 0.375rem;
      color: var(--color-foreground);
      opacity: 0.6;
      cursor: pointer;
      box-shadow: -3px 0 12px
        color-mix(in srgb, var(--color-foreground) 8%, transparent);
      transition: opacity 0.15s;
    }

    #toc-btn:hover,
    #toc-root.open #toc-btn {
      opacity: 1;
    }

    #toc-panel {
      /* Absolutely positioned to the LEFT of the trigger button.
         Both panel and trigger are inside #toc-root, so hovering
         the panel keeps #toc-root:hover active — no flicker. */
      position: absolute;
      right: 1.75rem;
      top: 0;
      width: 14rem;
      max-height: 70vh;
      overflow-y: auto;
      padding: 1rem 1rem 1rem 1.25rem;
      background: color-mix(in srgb, var(--color-background) 95%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid var(--color-border);
      border-right: none;
      border-radius: 0.5rem 0 0 0.5rem;
      box-shadow: -4px 4px 24px
        color-mix(in srgb, var(--color-foreground) 10%, transparent);
      /* Hidden state */
      opacity: 0;
      pointer-events: none;
      transform: translateX(0.5rem);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    /* Reveal on hover (desktop) OR .open class (mobile tap) */
    #toc-root:hover #toc-panel,
    #toc-root.open #toc-panel {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(0);
    }
  }
</style>

<script>
  function initToc(): void {
    const root = document.getElementById("toc-root");
    if (!root) return;

    const btn = document.getElementById("toc-btn") as HTMLButtonElement | null;
    const tocLinks = Array.from(
      root.querySelectorAll<HTMLAnchorElement>(".toc-link")
    );
    if (!tocLinks.length) return;

    const headingEls = Array.from(
      document.querySelectorAll<HTMLHeadingElement>(
        "#article h2[id], #article h3[id]"
      )
    );
    if (!headingEls.length) return;

    const controller = new AbortController();
    let activeLink: HTMLAnchorElement | null = null;

    // ── Mobile: tap trigger to toggle panel ──────────
    btn?.addEventListener(
      "click",
      e => {
        e.stopPropagation();
        const isOpen = root.classList.toggle("open");
        btn.setAttribute("aria-expanded", String(isOpen));
      },
      { signal: controller.signal }
    );

    // Close when tapping/clicking outside
    document.addEventListener(
      "click",
      e => {
        if (
          root.classList.contains("open") &&
          !root.contains(e.target as Node)
        ) {
          root.classList.remove("open");
          btn?.setAttribute("aria-expanded", "false");
        }
      },
      { signal: controller.signal }
    );

    // ── Scroll spy ───────────────────────────────────
    function setActive(link: HTMLAnchorElement | null): void {
      if (link === activeLink) return;
      activeLink?.classList.remove("toc-active");
      link?.classList.add("toc-active");
      activeLink = link;
    }

    function findActive(): void {
      // The last heading whose top edge has passed 120px from viewport top
      let active: HTMLHeadingElement | null = null;
      for (const h of headingEls) {
        if (h.getBoundingClientRect().top < 120) active = h;
      }
      const link = active
        ? (tocLinks.find(a => a.getAttribute("href") === `#${active!.id}`) ??
          null)
        : null;
      setActive(link);
    }

    let ticking = false;
    document.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            findActive();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true, signal: controller.signal }
    );

    // Abort listeners before next page swap to avoid leaks
    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
    });

    findActive();
  }

  initToc();
  document.addEventListener("astro:after-swap", initToc);
</script>
